# Storsy Backend Environment Configuration

# Server Port
PORT=8000

# Security (Generate a strong random key in production)
SECRET_KEY=sellsy_super_secret_production_key_change_in_prod_2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URL
# Defaults to local SQLite: sqlite:///./sellsy.db
# PostgreSQL on Railway: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=sqlite:///./sellsy.db

# Google Gemini AI Integration
# Used by Multi-Agent AI Team, Win-Back Generator, Content Generator & Executive Assistant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Shopify Partner App Credentials (Optional)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://sellsy.vercel.app

