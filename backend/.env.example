# ==========================================
# SELLSY BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

PROJECT_NAME="Sellsy - AI-Powered E-commerce Intelligence"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Production Secret Key
SECRET_KEY="replace_with_a_secure_random_64_char_hex_secret_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (Railway PostgreSQL or local SQLite)
# Format for Railway: postgresql://user:password@host:port/database
DATABASE_URL="sqlite:///./sellsy.db"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Shopify Storefront Integration
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_products,read_orders,read_customers,read_analytics"
